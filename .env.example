# ProofLoop is currently a local, dependency-free demo and needs no secrets.
PROOFLOOP_DATA_DIR=.data
# Optional OpenAI-compatible extraction service (keep real values out of Git).
PROOFLOOP_LLM_ENDPOINT=
PROOFLOOP_LLM_API_KEY=
PROOFLOOP_LLM_MODEL=gpt-4o-mini
PROOFLOOP_RATE_LIMIT_WINDOW_MS=60000
PROOFLOOP_RATE_LIMIT_MAX=60
